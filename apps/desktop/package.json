{
  "name": "@moonshot-ai/kimi-code-desktop",
  "version": "0.3.1",
  "private": true,
  "description": "Unofficial Windows-first desktop client derived from Kimi Code",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build": "pnpm run build:renderer && pnpm run build:main",
    "build:main": "tsdown --config tsdown.main.config.ts && tsdown --config tsdown.preload.config.ts",
    "build:renderer": "vite build",
    "dev:renderer": "vite",
    "dist:win": "pnpm run licenses:check && pnpm run build && electron-builder --win portable --x64",
    "e2e": "node e2e/desktop.e2e.mjs",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs --write",
    "pack:win": "pnpm run licenses:check && pnpm run build && electron-builder --win dir --x64",
    "release:check-tag": "node scripts/check-release-tag.mjs",
    "start": "electron .",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "build": {
    "appId": "ai.moonshot.kimi-code-desktop",
    "productName": "Kimi Code Desktop",
    "asar": true,
    "compression": "normal",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../../NOTICE.md",
        "to": "NOTICE.md"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "artifactName": "Kimi-Code-Desktop-${version}-${arch}-portable.${ext}",
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@moonshot-ai/kimi-code-sdk": "workspace:^",
    "@moonshot-ai/transcript": "workspace:^",
    "@tanstack/react-virtual": "^3.13.5",
    "chokidar": "^4.0.3",
    "lucide-react": "^1.30.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^43.3.0",
    "electron-builder": "26.15.3",
    "playwright": "^1.55.0",
    "spdx-expression-parse": "3.0.1",
    "tsdown": "0.22.0",
    "vite": "^6.3.3",
    "vitest": "4.1.4",
    "ws": "^8.18.0"
  }
}
